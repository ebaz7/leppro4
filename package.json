{
  "name": "payment-order-system",
  "description": "سامانه یکپارچه مالی، بازرگانی و کارتابل دستور پرداخت دلکام",
  "author": "Delcom Systems",
  "private": true,
  "version": "1.0.29",
  "type": "module",
  "scripts": {
    "dev": "node server.js --dev",
    "build": "node -e \"import('fs').then(fs => { if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true, force: true}); })\" && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "tsc --noEmit --skipLibCheck",
    "start": "node server.js",
    "icons": "node setup-assets.cjs",
    "release:tauri": "node setup-desktop-icons.cjs --release",
    "release:android": "node build-android.js --release",
    "mobile": "npm run build && npx cap sync android && npx cap open android",
    "build:apk": "node build-android.js",
    "build:apk-release": "node build-android.js --release",
    "build:apk:release": "node build-android.js --release",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "tauri": "tauri",
    "desktop:icons": "node setup-assets.cjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node setup-desktop-icons.cjs --release",
    "desktop:native": "node setup-build-version.cjs --platform electron --bump && npm run build && electron-builder --win --x64",
    "build:electron": "node setup-build-version.cjs --platform electron --bump && npm run build && electron-builder --win --x64",
    "build:electron:exact": "npm run build && electron-builder --win --x64",
    "release:web": "node setup-build-version.cjs --platform web --bump && npm run build",
    "set:version": "node setup-build-version.cjs",
    "electron:dev": "electron electron/main.cjs --dev",
    "tauri:build": "node setup-desktop-icons.cjs --release",
    "assets:generate": "node setup-assets.cjs",
    "postinstall": "node patch-dependencies.js"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capgo/capacitor-share-target": "^8.0.35",
    "@google/genai": "latest",
    "@onlyoffice/document-editor-react": "^2.2.0",
    "@puppeteer/browsers": "^3.2.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.5.10",
    "archiver": "^7.0.0",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-object": "^2.1.6",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1",
    "form-data": "^4.0.0",
    "html-to-docx": "^1.8.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jalaali-js": "^2.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "node-windows": "^1.0.0-beta.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.23.1",
    "pizzip": "^3.2.0",
    "puppeteer": "^22.0.0",
    "puppeteer-core": "^25.11.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-multi-date-picker": "^4.5.2",
    "react-quill": "^2.0.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "undici": "^8.11.2",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@capgo/capacitor-share-target": {
      "@capacitor/core": "$@capacitor/core",
      "@capacitor/android": "$@capacitor/android"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@tauri-apps/api": "^1.6.0",
    "@tauri-apps/cli": "^1.6.0",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.3",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
